{
  "name": "com.yato.framework",
  "version": "0.3.1",
  "displayName": "Yato Framework",
  "description": "Yato 通用 Unity 框架聚合包：依赖 Core / Mvc / Resources / UI / Editor 各子包，并附带示例、测试与 IL2CPP 裁剪配置。",
  "unity": "6000.0",
  "keywords": [
    "framework",
    "ui",
    "resource",
    "assetbundle",
    "yato"
  ],
  "author": {
    "name": "Yato"
  },
  "dependencies": {
    "com.yato.core": "0.1.0",
    "com.yato.mvc": "0.1.0",
    "com.yato.resources": "0.2.1",
    "com.yato.ui": "0.1.0",
    "com.yato.app": "0.1.0",
    "com.yato.persistence": "0.1.0",
    "com.yato.settings": "0.1.0",
    "com.yato.audio": "0.1.0",
    "com.yato.editor": "0.1.1"
  },
  "samples": [
    {
      "displayName": "BasicSample",
      "description": "Standalone Bootstrap, Resources, UI without a Facade, and scene transitions. No TMP or Input required.",
      "path": "Samples~/BasicSample"
    },
    {
      "displayName": "FullSample",
      "description": "Standalone Settings, Audio and transactional hot-update demo.",
      "path": "Samples~/FullSample"
    }
  ]
}
