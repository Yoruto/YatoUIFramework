{
  "name": "com.yato.framework",
  "version": "0.6.0",
  "displayName": "Yato Framework",
  "description": "Yato Unity 6 通用框架聚合包：流程、配置、资源、实例池、UI、App、设置、音频和编辑器工具；附独立示例、测试与裁剪配置。Save、Input 和 UI/Input 按需安装。",
  "unity": "6000.0",
  "keywords": [
    "framework",
    "ui",
    "resource",
    "assetbundle",
    "yato"
  ],
  "author": {
    "name": "Yato"
  },
  "dependencies": {
    "com.yato.core": "0.2.0",
    "com.yato.mvc": "0.1.0",
    "com.yato.resources": "0.3.0",
    "com.yato.ui": "0.3.0",
    "com.yato.app": "0.3.0",
    "com.yato.persistence": "0.1.1",
    "com.yato.settings": "0.1.1",
    "com.yato.audio": "0.1.1",
    "com.yato.editor": "0.3.0",
    "com.yato.flow": "0.2.0",
    "com.yato.config": "0.2.0",
    "com.yato.pooling": "0.2.0"
  },
  "samples": [
    {
      "displayName": "BasicSample",
      "description": "Standalone Bootstrap, Resources, UI without a Facade, and scene transitions. No TMP or Input required.",
      "path": "Samples~/BasicSample"
    },
    {
      "displayName": "FullSample",
      "description": "Standalone Flow, Config, Pooling, Settings, Audio and transactional hot-update demo.",
      "path": "Samples~/FullSample"
    }
  ]
}
