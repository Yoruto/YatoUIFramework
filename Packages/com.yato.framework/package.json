{
  "name": "com.yato.framework",
  "version": "0.7.0",
  "displayName": "Yato Framework",
  "description": "Yato Unity 6 框架全量聚合包；资源基础、AssetBundle 和资源热更新可独立安装。离线项目可直接组合子包。",
  "unity": "6000.0",
  "keywords": [
    "framework",
    "ui",
    "resource",
    "assetbundle",
    "yato"
  ],
  "author": {
    "name": "Yato"
  },
  "dependencies": {
    "com.yato.core": "0.2.0",
    "com.yato.mvc": "0.1.0",
    "com.yato.resources": "0.4.0",
    "com.yato.ui": "0.3.0",
    "com.yato.app": "0.3.0",
    "com.yato.persistence": "0.1.1",
    "com.yato.settings": "0.1.1",
    "com.yato.audio": "0.1.1",
    "com.yato.editor": "0.4.0",
    "com.yato.flow": "0.2.0",
    "com.yato.config": "0.2.0",
    "com.yato.pooling": "0.2.0",
    "com.yato.resources.bundle": "0.1.0",
    "com.yato.resources.hotupdate": "0.1.0"
  },
  "samples": [
    {
      "displayName": "BasicSample",
      "description": "Standalone Bootstrap, Resources, UI without a Facade, and scene transitions. No TMP or Input required.",
      "path": "Samples~/BasicSample"
    },
    {
      "displayName": "FullSample",
      "description": "Offline Flow, Config, Pooling, Settings and Audio demo. Resource hot-update demo is separately supplied by Yato Resources HotUpdate.",
      "path": "Samples~/FullSample"
    }
  ]
}
